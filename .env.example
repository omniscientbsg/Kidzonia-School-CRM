# Copy to apps/api/.env for local development. Every value here is safe for
# development only; production values come from the real environment.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Behind a proxy/load balancer, how many hops to trust for the client IP.
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://kidzonia:kidzonia@localhost:55432/kidzonia
# Integration tests clone per-worker databases from this one.
TEST_DATABASE_URL=postgresql://kidzonia:kidzonia@localhost:55432/kidzonia_test

# --- Auth secrets (at least 32 random characters each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Previous JWT secret, accepted for verification only while rotating (optional).
JWT_SECRET_PREVIOUS=
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789abcdef

# --- Token lifetimes ---
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30

# --- One-time codes ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev-only: accept this fixed code for everyone. The server refuses to start
# with this set when NODE_ENV=production.
DEV_FIXED_OTP=123456

# --- Rate limits (all counts are per window) ---
RL_OTP_PER_MOBILE_10MIN=3
RL_OTP_PER_IP_10MIN=10
RL_OTP_PER_MOBILE_DAY=10
RL_OTP_PER_IP_DAY=50
RL_LOGIN_PER_MOBILE_15MIN=10
RL_LOGIN_PER_IP_15MIN=30
RL_REGISTER_PER_IP_DAY=5
RL_INVITE_PER_USER_DAY=3

# --- Registration and invites ---
APP_URL=http://localhost:5173
REGISTRATION_TOKEN_TTL_MINUTES=30

# --- File storage (logos now, task photos in Phase 3) ---
# local: files on disk under STORAGE_LOCAL_DIR (development, or a mounted volume).
# s3: any S3-compatible store; needs S3_BUCKET and S3_REGION (S3_ENDPOINT for non-AWS).
# docker-compose runs one on http://localhost:59000 (access key kidzonia,
# secret kidzonia-s3-secret) that the storage tests use.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Messaging provider (Open decision 13.2) ---
# Only "console" exists until a provider is chosen.
MESSAGE_PROVIDER=console

# Tasks: most people one task can go to, upload limits (MB) and files per task.
TASK_MAX_RECIPIENTS=1000
TASK_IMAGE_MAX_MB=15
TASK_FILE_MAX_MB=10
TASK_FILES_PER_COPY=10
# Deferring a copy: from tomorrow up to this many days ahead.
TASK_DEFER_MAX_DAYS=14
# Test-only routes that move the clock and run jobs (Playwright). Refused in production.
E2E_TEST_HOOKS=0

# Notifications (Phase 5): in-app notifications are kept this many days from creation.
NOTIFICATIONS_KEEP_DAYS=90
# SMS/WhatsApp notifications per organisation per day; more are skipped and logged.
SMS_DAILY_CAP_PER_ORG=500
# Report CSV downloads per person per hour.
RL_EXPORTS_PER_USER_HOUR=10
# Messages to parents (Phase 6): per organisation per day, and per parent per day.
PARENT_DAILY_CAP_PER_ORG=2000
PARENT_DAILY_LIMIT_PER_PARENT=3
# Rows in one parent-contacts CSV upload.
CONTACTS_CSV_MAX_ROWS=2000

# --- Error tracking (Phase 6): off unless a DSN is set, in every environment ---
# Sentry-compatible DSN for the API. Leave empty in development.
ERROR_TRACKING_DSN=
# Label on reports (production, staging); defaults to NODE_ENV.
ERROR_TRACKING_ENVIRONMENT=
# The DSN the web app was built with (build arg VITE_ERROR_TRACKING_DSN); lets
# the browser send reports through the Content-Security-Policy.
WEB_ERROR_TRACKING_DSN=
# Release name on reports; the release workflow sets it to the version tag.
APP_VERSION=

# --- Backups and ops scripts (Phase 6; see docs/operations/runbook.md) ---
# Only the backup, restore and staging-migrate-test scripts read these.
BACKUP_BUCKET=
BACKUP_PREFIX=db-backups/
BACKUP_KEEP_DAYS=30
# Each falls back to the S3_* value above when empty.
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Dropped and recreated by staging-migrate-test; never the live database.
STAGING_DATABASE_URL=
# Folder with pg_dump/pg_restore when they're not on PATH.
PG_BIN=
# Local testing only (refused in production): run pg_dump/pg_restore inside the
# docker-compose Postgres container, e.g. kidzonia360-db-1.
PG_DOCKER_CONTAINER=
