# Copy to apps/api/.env for local development. Every value here is safe for
# development only; production values come from the real environment.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Behind a proxy/load balancer, how many hops to trust for the client IP.
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://kidzonia:kidzonia@localhost:55432/kidzonia
# Integration tests clone per-worker databases from this one.
TEST_DATABASE_URL=postgresql://kidzonia:kidzonia@localhost:55432/kidzonia_test

# --- Auth secrets (at least 32 random characters each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Previous JWT secret, accepted for verification only while rotating (optional).
JWT_SECRET_PREVIOUS=
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789abcdef

# --- Token lifetimes ---
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30

# --- One-time codes ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev-only: accept this fixed code for everyone. The server refuses to start
# with this set when NODE_ENV=production.
DEV_FIXED_OTP=123456

# --- Rate limits (all counts are per window) ---
RL_OTP_PER_MOBILE_10MIN=3
RL_OTP_PER_IP_10MIN=10
RL_OTP_PER_MOBILE_DAY=10
RL_OTP_PER_IP_DAY=50
RL_LOGIN_PER_MOBILE_15MIN=10
RL_LOGIN_PER_IP_15MIN=30
RL_REGISTER_PER_IP_DAY=5
RL_INVITE_PER_USER_DAY=3

# --- Registration and invites ---
APP_URL=http://localhost:5173
REGISTRATION_TOKEN_TTL_MINUTES=30

# --- File storage (logos now, task photos in Phase 3) ---
# local: files on disk under STORAGE_LOCAL_DIR (development, or a mounted volume).
# s3: any S3-compatible store; needs S3_BUCKET and S3_REGION (S3_ENDPOINT for non-AWS).
# docker-compose runs one on http://localhost:59000 (access key kidzonia,
# secret kidzonia-s3-secret) that the storage tests use.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Messaging provider (Open decision 13.2) ---
# Only "console" exists until a provider is chosen.
MESSAGE_PROVIDER=console
