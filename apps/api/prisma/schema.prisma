// Kidzonia 360 database schema.
//
// Tenancy rules enforced by the database itself, not only by code:
// - Every org-scoped table has UNIQUE (organisation_id, id).
// - Every reference between org-scoped tables is a composite foreign key
//   (organisation_id, x_id) -> (organisation_id, id), so a row can never point
//   at another organisation's row, and relation includes can't cross orgs.
// - created_by / updated_by are audit stamps set by the data layer from the
//   request context, never from input, and have no foreign key so they survive
//   user deletion (like audit_log).
//
// Constraints Prisma can't express (partial unique indexes, CHECKs, the reports-to
// loop trigger) live in raw SQL inside the migrations. Never edit a committed
// migration; add a new one.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  // Emit ".js" import specifiers so the generated code works under NodeNext.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SetupType {
  single_school
  head_office
}

enum SchoolModel {
  coco
  franchise
  both
}

enum SchoolType {
  coco
  franchise
}

enum UserStatus {
  invited
  active
  inactive
}

enum Reach {
  own
  team
  school
  all
}

enum FieldAccess {
  hidden
  view
  edit
}

enum OwnRecordRule {
  same
  edit
}

enum FieldChangeStatus {
  pending
  approved
  rejected
  /// Replaced by a newer request for the same field and record.
  superseded
  /// The value changed after the request was made, so it wasn't applied.
  out_of_date
}

model Organisation {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String
  logoKey     String?     @map("logo_key")
  setupType   SetupType   @map("setup_type")
  schoolModel SchoolModel @map("school_model")
  timezone    String      @default("Asia/Kolkata")
  /// Weekday numbers 0 (Sunday) to 6 (Saturday).
  workingDays Int[]       @default([1, 2, 3, 4, 5, 6]) @map("working_days")
  /// "HH:MM" local time; a CHECK constraint enforces the format.
  opensAt     String      @default("08:00") @map("opens_at")
  closesAt    String      @default("16:00") @map("closes_at")
  /// Set when an Owner hides the setup checklist on Home.
  checklistDismissedAt DateTime? @map("checklist_dismissed_at") @db.Timestamptz(3)
  /// A blocking task due today blocks logout from this many minutes before its
  /// deadline (Phase 4 addition a). 0 = only once the deadline has passed.
  logoutBlockLeadMinutes Int   @default(120) @map("logout_block_lead_minutes")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?     @map("created_by") @db.Uuid
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?     @map("updated_by") @db.Uuid

  schools                 School[]
  users                   User[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  roleFieldPermissions    RoleFieldPermission[]
  roleAssignments         RoleAssignment[]
  roleAssignmentSchools   RoleAssignmentSchool[]
  automaticRoleSettings   AutomaticRoleSetting[]
  authSessions            AuthSession[]
  activity                Activity[]
  auditLog                AuditLog[]
  holidays                Holiday[]
  holidaySchools          HolidaySchool[]
  pendingFieldChanges     PendingFieldChange[]
  taskCategories          TaskCategory[]
  taskPriorities          TaskPriority[]
  taskLists               TaskList[]
  taskListValues          TaskListValue[]
  parentMessageTemplates  ParentMessageTemplate[]
  taskTemplates           TaskTemplate[]
  tasks                   Task[]
  taskSubtasks            TaskSubtask[]
  taskWatchers            TaskWatcher[]
  taskAssignments         TaskAssignment[]
  taskAssignmentSubtasks  TaskAssignmentSubtask[]
  taskAttachments         TaskAttachment[]
  dayEndForms             DayEndForm[]
  dayEndFormVersions      DayEndFormVersion[]
  dayEndFormRoles         DayEndFormRole[]
  logoutReleases          LogoutRelease[]
  releaseRequests         ReleaseRequest[]
  outbox                  NotificationOutbox[]

  @@map("organisations")
}

model School {
  id                   String     @id @default(uuid(7)) @db.Uuid
  organisationId       String     @map("organisation_id") @db.Uuid
  name                 String
  city                 String
  state                String?
  type                 SchoolType
  franchiseOwnerUserId String?    @map("franchise_owner_user_id") @db.Uuid
  principalUserId      String?    @map("principal_user_id") @db.Uuid
  /// Empty means "use the organisation's working days".
  workingDays          Int[]      @default([]) @map("working_days")
  opensAt              String?    @map("opens_at")
  closesAt             String?    @map("closes_at")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy            String?    @map("created_by") @db.Uuid
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy            String?    @map("updated_by") @db.Uuid
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz(3)

  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  franchiseOwner User?                  @relation("SchoolFranchiseOwner", fields: [organisationId, franchiseOwnerUserId], references: [organisationId, id], onDelete: Restrict)
  principal      User?                  @relation("SchoolPrincipal", fields: [organisationId, principalUserId], references: [organisationId, id], onDelete: Restrict)
  homeOf         User[]                 @relation("UserHomeSchool")
  scopedIn       RoleAssignmentSchool[]
  holidays       HolidaySchool[]
  taskCopies     TaskAssignment[]

  @@unique([organisationId, id])
  @@index([organisationId, franchiseOwnerUserId])
  @@index([organisationId, principalUserId])
  @@map("schools")
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  organisationId  String     @map("organisation_id") @db.Uuid
  fullName        String     @map("full_name")
  /// E.164, e.g. +919848011201. Unique per organisation among live users.
  mobile          String
  email           String?
  employeeId      String?    @map("employee_id")
  jobTitle        String?    @map("job_title")
  photoKey        String?    @map("photo_key")
  /// Null means head office.
  homeSchoolId    String?    @map("home_school_id") @db.Uuid
  reportsToUserId String?    @map("reports_to_user_id") @db.Uuid
  department      String?
  startDate       DateTime?  @map("start_date") @db.Date
  status          UserStatus @default(invited)
  passwordHash    String?    @map("password_hash")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  invitedAt       DateTime?  @map("invited_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?    @map("created_by") @db.Uuid
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?    @map("updated_by") @db.Uuid
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  organisation     Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  homeSchool       School?         @relation("UserHomeSchool", fields: [organisationId, homeSchoolId], references: [organisationId, id], onDelete: Restrict)
  reportsTo        User?           @relation("UserReportsTo", fields: [organisationId, reportsToUserId], references: [organisationId, id], onDelete: Restrict)
  directReports    User[]          @relation("UserReportsTo")
  franchiseSchools School[]        @relation("SchoolFranchiseOwner")
  principalOf      School[]        @relation("SchoolPrincipal")
  fieldChangesAbout     PendingFieldChange[] @relation("FieldChangeSubject")
  fieldChangesRequested PendingFieldChange[] @relation("FieldChangeRequester")
  fieldChangesDecided   PendingFieldChange[] @relation("FieldChangeDecider")
  roleAssignment   RoleAssignment?
  sessions         AuthSession[]
  activity         Activity[]
  auditEntries     AuditLog[]
  tasksCreated        Task[]                  @relation("TaskCreator")
  tasksApproving      Task[]                  @relation("TaskApprover")
  subtasksAssigned    TaskSubtask[]           @relation("SubtaskAssignee")
  tasksWatching       TaskWatcher[]           @relation("TaskWatcherUser")
  taskCopies          TaskAssignment[]        @relation("AssignmentUser")
  taskCopiesApproving TaskAssignment[]        @relation("AssignmentApprover")
  taskCopiesDecided   TaskAssignment[]        @relation("AssignmentDecider")
  subtasksTicked      TaskAssignmentSubtask[] @relation("SubtaskTicker")
  attachmentsUploaded TaskAttachment[]        @relation("AttachmentUploader")
  logoutReleases      LogoutRelease[]         @relation("ReleasedPerson")
  releasesGiven       LogoutRelease[]         @relation("ReleasedBy")
  releaseRequests     ReleaseRequest[]
  outbox              NotificationOutbox[]

  @@unique([organisationId, id])
  @@index([mobile])
  @@index([organisationId, homeSchoolId])
  @@index([organisationId, reportsToUserId])
  @@index([organisationId, status])
  @@map("users")
}

model Role {
  id                String    @id @default(uuid(7)) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  name              String
  description       String?
  isOwner           Boolean   @default(false) @map("is_owner")
  createdFromRoleId String?   @map("created_from_role_id") @db.Uuid
  /// Which seed role this started as (brief 5.6), so code never matches on an editable name.
  seedKey           String?   @map("seed_key")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdFrom      Role?                 @relation("RoleCopiedFrom", fields: [organisationId, createdFromRoleId], references: [organisationId, id], onDelete: Restrict)
  copies           Role[]                @relation("RoleCopiedFrom")
  permissions      RolePermission[]
  fieldPermissions RoleFieldPermission[]
  assignments      RoleAssignment[]
  dayEndForms      DayEndFormRole[]

  @@unique([organisationId, id])
  @@index([organisationId, createdFromRoleId])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  moduleKey      String   @map("module_key")
  actions        String[]
  /// Null for modules without reach.
  reach          Reach?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?  @map("updated_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([roleId, moduleKey])
  @@index([organisationId, roleId])
  @@map("role_permissions")
}

model RoleFieldPermission {
  id             String        @id @default(uuid(7)) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  roleId         String        @map("role_id") @db.Uuid
  moduleKey      String        @map("module_key")
  fieldKey       String        @map("field_key")
  access         FieldAccess
  ownRecord      OwnRecordRule @default(same) @map("own_record")
  needsApproval  Boolean       @default(false) @map("needs_approval")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?       @map("updated_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([roleId, moduleKey, fieldKey])
  @@index([organisationId, roleId])
  @@map("role_field_permissions")
}

/// One role per user in v1 (unique user_id), kept as its own table so more
/// roles per user can be allowed later without moving data.
model RoleAssignment {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  scopeAllSchools Boolean  @default(false) @map("scope_all_schools")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?  @map("created_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?  @map("updated_by") @db.Uuid

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User                   @relation(fields: [organisationId, userId], references: [organisationId, id], onDelete: Cascade)
  role         Role                   @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict)
  schools      RoleAssignmentSchool[]

  @@unique([organisationId, id])
  @@index([organisationId, roleId])
  @@unique([organisationId, userId])
  @@map("role_assignments")
}

/// The schools a role assignment covers (decided: a join table rather than a
/// uuid array, so the database guarantees every school exists and is ours).
model RoleAssignmentSchool {
  organisationId String   @map("organisation_id") @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignment   RoleAssignment @relation(fields: [organisationId, assignmentId], references: [organisationId, id], onDelete: Cascade)
  school       School         @relation(fields: [organisationId, schoolId], references: [organisationId, id], onDelete: Restrict)

  @@id([assignmentId, schoolId])
  @@index([organisationId, assignmentId])
  @@index([organisationId, schoolId])
  @@map("role_assignment_schools")
}

/// Values of the reporting-manager switches (brief 6.3). Switch keys come from
/// the module registry; a missing row means the switch's default.
model AutomaticRoleSetting {
  organisationId String   @map("organisation_id") @db.Uuid
  switchKey      String   @map("switch_key")
  enabled        Boolean
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?  @map("updated_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([organisationId, switchKey])
  @@map("automatic_role_settings")
}

/// One-time sign-in codes. Not org-scoped: a code is requested before we know
/// which organisation the person will open.
model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  mobile     String
  /// HMAC-SHA256 of the code with a server secret; the code itself is never stored.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mobile, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// A signed-in device. Access tokens carry the session id, so revoking the
/// session (logout, deactivation) takes effect immediately.
model AuthSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// SHA-256 of the current refresh token. Rotated on every refresh.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// All sessions descended from one sign-in; reuse of an old token revokes the family.
  familyId         String    @map("family_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organisationId, userId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// The Home "Updates" feed: who did what to which record. Never the record's contents.
model Activity {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  /// People the change is about, for "actions aimed at them".
  subjectUserIds String[] @map("subject_user_ids") @db.Uuid
  schoolId       String?  @map("school_id") @db.Uuid
  /// Organisation-wide events (e.g. a new holiday) show to everyone.
  orgWide        Boolean  @default(false) @map("org_wide")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [organisationId, actorUserId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([organisationId, actorUserId])
  @@index([subjectUserIds], type: Gin)
  @@map("activity")
}

/// Deliberate record of important changes, with before/after for settings.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [organisationId, actorUserId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([organisationId, entityType, entityId])
  @@index([organisationId, actorUserId])
  @@map("audit_log")
}

/// Storage for rate-limiter-flexible (RateLimiterPostgres with tableCreated).
/// The column layout must match what that library expects.
model RateLimit {
  key    String @id @db.VarChar(255)
  points Int    @default(0)
  expire BigInt?

  @@index([expire])
  @@map("rate_limits")
}

model Holiday {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  startDate      DateTime  @map("start_date") @db.Date
  /// Same as start_date for a one-day holiday.
  endDate        DateTime  @map("end_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  schools      HolidaySchool[]

  @@unique([organisationId, id])
  @@index([organisationId, startDate])
  @@map("holidays")
}

/// Schools a holiday applies to. No rows means every school.
model HolidaySchool {
  organisationId String   @map("organisation_id") @db.Uuid
  holidayId      String   @map("holiday_id") @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  holiday      Holiday      @relation(fields: [organisationId, holidayId], references: [organisationId, id], onDelete: Cascade)
  school       School       @relation(fields: [organisationId, schoolId], references: [organisationId, id], onDelete: Restrict)

  @@id([holidayId, schoolId])
  @@index([organisationId, holidayId])
  @@index([organisationId, schoolId])
  @@map("holiday_schools")
}

/// A change to a field whose role says "changes need approval" (brief 6.2 rule 5).
model PendingFieldChange {
  id             String            @id @default(uuid(7)) @db.Uuid
  organisationId String            @map("organisation_id") @db.Uuid
  moduleKey      String            @map("module_key")
  recordId       String            @map("record_id") @db.Uuid
  /// The person the record is about; their nearest active manager approves.
  subjectUserId  String            @map("subject_user_id") @db.Uuid
  fieldKey       String            @map("field_key")
  oldValue       Json?             @map("old_value")
  newValue       Json?             @map("new_value")
  status         FieldChangeStatus @default(pending)
  requestedBy    String            @map("requested_by") @db.Uuid
  decidedBy      String?           @map("decided_by") @db.Uuid
  decidedAt      DateTime?         @map("decided_at") @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  subject      User         @relation("FieldChangeSubject", fields: [organisationId, subjectUserId], references: [organisationId, id], onDelete: Restrict)
  requester    User         @relation("FieldChangeRequester", fields: [organisationId, requestedBy], references: [organisationId, id], onDelete: Restrict)
  decider      User?        @relation("FieldChangeDecider", fields: [organisationId, decidedBy], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, status, subjectUserId])
  @@index([organisationId, subjectUserId])
  @@index([organisationId, requestedBy])
  @@index([organisationId, decidedBy])
  @@index([organisationId, moduleKey, recordId, fieldKey])
  @@map("pending_field_changes")
}

/// Short-lived tokens that must work only once (organisation picker, registration).
/// Not org-scoped: they are used before an organisation is chosen.
model OneTimeToken {
  jti       String    @id @db.Uuid
  purpose   String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("one_time_tokens")
}

// ---------------------------------------------------------------------------
// Tasks (brief 9). A task is the rule; a task_assignment is one person's copy
// for one date ("today's task"). Tables are shaped for Phase 4 already: the
// repeat fields, generated_through and the (task, user, service_date) unique
// index are what the repeating-copies job needs.
// ---------------------------------------------------------------------------

enum TaskKind {
  task
  day_end
}

enum TaskDueType {
  end_of_day
  at_time
  on_date
}

enum TaskRepeat {
  none
  daily
  weekly
  monthly
}

enum ApproverMode {
  creator
  reporting_manager
  named_user
}

enum WatcherAccess {
  view
  edit
}

/// Kept in step with TASK_STATUSES in packages/shared (a test checks).
enum AssignmentStatus {
  todo
  in_progress
  submitted
  approved
  done
  sent_back
  overdue
  expired
  cancelled
}

model TaskCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  /// "#RRGGBB"; a CHECK constraint enforces the format.
  color          String
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  /// Archived instead of deleted, so tasks that use it still show it.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tasks        Task[]

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt])
  @@map("task_categories")
}

model TaskPriority {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  color          String
  /// 0 = most urgent. Everything that sorts by urgency uses this, never the name.
  sortOrder      Int       @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tasks        Task[]

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt, sortOrder])
  @@map("task_priorities")
}

/// An admin-made dropdown (e.g. "Area"). Each live list is a field of `tasks`.
model TaskList {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  values       TaskListValue[]

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt])
  @@map("task_lists")
}

model TaskListValue {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  listId         String    @map("list_id") @db.Uuid
  value          String
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  list         TaskList     @relation(fields: [organisationId, listId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, listId])
  @@map("task_list_values")
}

/// Brief 9.12. Stored and previewed in Phase 3; sending comes in Phase 6.
model ParentMessageTemplate {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  body           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt])
  @@map("parent_message_templates")
}

/// A saved task without people or fixed dates (brief 9.10). `payload` is
/// validated by the shared template schema; the server strips people and dates.
model TaskTemplate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?  @map("updated_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, name])
  @@map("task_templates")
}

model Task {
  id                 String       @id @default(uuid(7)) @db.Uuid
  organisationId     String       @map("organisation_id") @db.Uuid
  kind               TaskKind     @default(task)
  title              String
  description        String?
  categoryId         String?      @map("category_id") @db.Uuid
  priorityId         String?      @map("priority_id") @db.Uuid
  /// list id -> value id.
  customValues       Json         @default("{}") @map("custom_values")
  dueType            TaskDueType  @map("due_type")
  /// "HH:MM"; null for end of day.
  dueTime            String?      @map("due_time")
  /// on_date only.
  dueDate            DateTime?    @map("due_date") @db.Date
  repeat             TaskRepeat   @default(none)
  /// weekly: weekday numbers 0 (Sunday) to 6.
  repeatWeekdays     Int[]        @default([]) @map("repeat_weekdays")
  /// monthly: 1-31, clamped to the month's last day.
  repeatMonthDay     Int?         @map("repeat_month_day")
  repeatStartDate    DateTime     @map("repeat_start_date") @db.Date
  /// Stop repeating after this date (brief 9.5: not the deadline, not closing).
  repeatEndDate      DateTime?    @map("repeat_end_date") @db.Date
  /// Copies can still be submitted this long after the deadline; null = never closes.
  closesAfterMinutes Int?         @map("closes_after_minutes")
  needsApproval      Boolean      @default(false) @map("needs_approval")
  approverMode       ApproverMode @default(creator) @map("approver_mode")
  approverUserId     String?      @map("approver_user_id") @db.Uuid
  blocksLogout       Boolean      @default(false) @map("blocks_logout")
  /// { templateId, className } or null.
  parentMessage      Json?        @map("parent_message")
  /// Brief 9.3: { userIds, roleIds, schoolIds, excludeUserIds, includeNewJoiners }.
  target             Json
  /// Day-end forms arrive in Phase 4 (their foreign key is added then).
  dayEndFormId       String?      @map("day_end_form_id") @db.Uuid
  /// Informational only; editing or deleting a template never touches tasks.
  fromTemplateId     String?      @map("from_template_id") @db.Uuid
  /// The last service date copies have been made for (the Phase 4 job's watermark).
  generatedThrough   DateTime?    @map("generated_through") @db.Date
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  /// The creator. Unlike other tables' created_by stamps this is a business
  /// fact (who assigned it, who may edit it), so it has a foreign key.
  createdBy          String       @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String?      @map("updated_by") @db.Uuid

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  category     TaskCategory?    @relation(fields: [organisationId, categoryId], references: [organisationId, id], onDelete: Restrict)
  priority     TaskPriority?    @relation(fields: [organisationId, priorityId], references: [organisationId, id], onDelete: Restrict)
  creator      User             @relation("TaskCreator", fields: [organisationId, createdBy], references: [organisationId, id], onDelete: Restrict)
  approver     User?            @relation("TaskApprover", fields: [organisationId, approverUserId], references: [organisationId, id], onDelete: Restrict)
  dayEndForm   DayEndForm?      @relation("DayEndFormTask", fields: [organisationId, dayEndFormId], references: [organisationId, id], onDelete: Restrict)
  subtasks     TaskSubtask[]
  watchers     TaskWatcher[]
  assignments  TaskAssignment[]

  @@unique([organisationId, id])
  @@index([organisationId, createdBy, createdAt(sort: Desc)])
  @@index([organisationId, categoryId])
  @@index([organisationId, priorityId])
  @@index([organisationId, approverUserId])
  @@index([organisationId, kind])
  @@index([organisationId, dayEndFormId])
  @@map("tasks")
}

model TaskSubtask {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  title          String
  sortOrder      Int       @map("sort_order")
  /// Only when the task goes to one named person (addition a).
  assigneeUserId String?   @map("assignee_user_id") @db.Uuid
  dueTime        String?   @map("due_time")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Never hard-deleted: copies already handed out still point at it.
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  task         Task                    @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Cascade)
  assignee     User?                   @relation("SubtaskAssignee", fields: [organisationId, assigneeUserId], references: [organisationId, id], onDelete: Restrict)
  ticks        TaskAssignmentSubtask[]

  @@unique([organisationId, id])
  @@index([organisationId, taskId])
  @@index([organisationId, assigneeUserId])
  @@map("task_subtasks")
}

model TaskWatcher {
  organisationId String        @map("organisation_id") @db.Uuid
  taskId         String        @map("task_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  access         WatcherAccess
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?       @map("created_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  task         Task         @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Cascade)
  user         User         @relation("TaskWatcherUser", fields: [organisationId, userId], references: [organisationId, id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([organisationId, userId])
  @@index([organisationId, taskId])
  @@map("task_watchers")
}

/// One person's copy of a task for one date.
model TaskAssignment {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  taskId         String           @map("task_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// The person's school when the copy was made (null = head office).
  schoolId       String?          @map("school_id") @db.Uuid
  serviceDate    DateTime         @map("service_date") @db.Date
  dueAt          DateTime         @map("due_at") @db.Timestamptz(3)
  closesAt       DateTime?        @map("closes_at") @db.Timestamptz(3)
  status         AssignmentStatus @default(todo)
  needsApproval  Boolean          @map("needs_approval")
  approverUserId String?          @map("approver_user_id") @db.Uuid
  blocksLogout   Boolean          @map("blocks_logout")
  /// { title, description, subtasks: [{ id, title, order, assigneeUserId }] }:
  /// what the person works from, so later edits don't rewrite work in progress.
  snapshot       Json
  answers        Json?
  remarks        String?
  cancelReason   String?          @map("cancel_reason")
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz(3)
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz(3)
  decidedBy      String?          @map("decided_by") @db.Uuid
  cancelledBy    String?          @map("cancelled_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  task         Task                    @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Cascade)
  user         User                    @relation("AssignmentUser", fields: [organisationId, userId], references: [organisationId, id], onDelete: Restrict)
  school       School?                 @relation(fields: [organisationId, schoolId], references: [organisationId, id], onDelete: Restrict)
  approver     User?                   @relation("AssignmentApprover", fields: [organisationId, approverUserId], references: [organisationId, id], onDelete: Restrict)
  decider      User?                   @relation("AssignmentDecider", fields: [organisationId, decidedBy], references: [organisationId, id], onDelete: Restrict)
  ticks        TaskAssignmentSubtask[]
  attachments  TaskAttachment[]

  @@unique([organisationId, id])
  @@unique([taskId, userId, serviceDate])
  @@index([organisationId, userId, status, dueAt])
  @@index([organisationId, approverUserId, status])
  @@index([organisationId, taskId, status])
  @@index([organisationId, schoolId, serviceDate])
  @@index([organisationId, decidedBy])
  @@index([status, dueAt])
  @@index([status, closesAt])
  @@map("task_assignments")
}

/// A row means the sub-task is ticked on that copy.
model TaskAssignmentSubtask {
  organisationId String   @map("organisation_id") @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  subtaskId      String   @map("subtask_id") @db.Uuid
  doneAt         DateTime @default(now()) @map("done_at") @db.Timestamptz(3)
  doneBy         String   @map("done_by") @db.Uuid

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignment   TaskAssignment @relation(fields: [organisationId, assignmentId], references: [organisationId, id], onDelete: Cascade)
  subtask      TaskSubtask    @relation(fields: [organisationId, subtaskId], references: [organisationId, id], onDelete: Restrict)
  doer         User           @relation("SubtaskTicker", fields: [organisationId, doneBy], references: [organisationId, id], onDelete: Restrict)

  @@id([assignmentId, subtaskId])
  @@index([organisationId, assignmentId])
  @@index([organisationId, subtaskId])
  @@index([organisationId, doneBy])
  @@map("task_assignment_subtasks")
}

model TaskAttachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  storageKey     String   @map("storage_key")
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  width          Int?
  height         Int?
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignment   TaskAssignment @relation(fields: [organisationId, assignmentId], references: [organisationId, id], onDelete: Cascade)
  uploader     User           @relation("AttachmentUploader", fields: [organisationId, uploadedBy], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, assignmentId])
  @@index([organisationId, uploadedBy])
  @@map("task_attachments")
}

// ---------------------------------------------------------------------------
// Phase 4: the schedule job, the logout block, day-end forms, reminders.
// ---------------------------------------------------------------------------

enum JobRunStatus {
  running
  succeeded
  failed
  skipped
}

/// One run of a background job. Not org-scoped: one run serves every organisation.
model JobRun {
  id         String       @id @default(uuid(7)) @db.Uuid
  job        String
  status     JobRunStatus
  startedAt  DateTime     @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(3)
  /// Counts of what the run did, for the log and the Owner's status line.
  counts     Json?
  error      String?
  /// Set when the run found it hadn't run for a while (downtime).
  gapFrom    DateTime?    @map("gap_from") @db.Timestamptz(3)
  server     String?

  @@index([job, status, startedAt(sort: Desc)])
  @@map("job_runs")
}

/// A day-end report form (brief 9.11). Each has one generated daily task.
model DayEndForm {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  blocksLogout   Boolean   @default(true) @map("blocks_logout")
  /// The version new copies get.
  currentVersion Int       @default(1) @map("current_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  versions     DayEndFormVersion[]
  roles        DayEndFormRole[]
  tasks        Task[]              @relation("DayEndFormTask")

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt])
  @@map("day_end_forms")
}

/// The questions of one version of a form. Never changed once written, so a
/// report always reads with the questions it was given.
model DayEndFormVersion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  formId         String   @map("form_id") @db.Uuid
  version        Int
  questions      Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  form         DayEndForm   @relation(fields: [organisationId, formId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@unique([formId, version])
  @@index([organisationId, formId])
  @@map("day_end_form_versions")
}

model DayEndFormRole {
  organisationId String   @map("organisation_id") @db.Uuid
  formId         String   @map("form_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  form         DayEndForm   @relation(fields: [organisationId, formId], references: [organisationId, id], onDelete: Cascade)
  role         Role         @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict)

  @@id([formId, roleId])
  @@index([organisationId, formId])
  @@index([organisationId, roleId])
  @@map("day_end_form_roles")
}

/// "Released for today" (brief 9.7): one row per person per date.
model LogoutRelease {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  serviceDate    DateTime @map("service_date") @db.Date
  releasedBy     String   @map("released_by") @db.Uuid
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation("ReleasedPerson", fields: [organisationId, userId], references: [organisationId, id], onDelete: Restrict)
  releaser     User         @relation("ReleasedBy", fields: [organisationId, releasedBy], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@unique([userId, serviceDate])
  @@index([organisationId, userId, serviceDate])
  @@index([organisationId, releasedBy])
  @@map("logout_releases")
}

/// "Ask for release", kept for the daily limit and the record.
model ReleaseRequest {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organisationId, userId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, userId, createdAt])
  @@map("release_requests")
}

/// Notification events waiting to be delivered (brief 10.1). Phase 4 writes
/// them; Phase 5 delivers them and builds the screens.
model NotificationOutbox {
  id              String    @id @default(uuid(7)) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  event           String
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id") @db.Uuid
  payload         Json      @default("{}")
  /// The same event is never written twice (e.g. a job that runs again).
  dedupeKey       String    @map("dedupe_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  recipient    User         @relation(fields: [organisationId, recipientUserId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@unique([organisationId, dedupeKey])
  @@index([organisationId, recipientUserId, createdAt(sort: Desc)])
  @@index([deliveredAt])
  @@map("notification_outbox")
}
